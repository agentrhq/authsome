// Apollo
// Sales intelligence and prospecting data for go-to-market workflows.
// auth: api_key | flow: api_key
// API keys are found at app.apollo.io/#/settings/integrations/api.
{
  "schema_version": 1,
  "name": "apollo",
  "display_name": "Apollo",
  "logo": "img.logo.dev/name/apollo",
  "description": "Sales intelligence and prospecting data for go-to-market workflows.",
  "type": "app",
  "auth_type": "api_key",
  "flow": "api_key",
  "api_url": "api.apollo.io",
  "api_key": {
    "header_name": "Authorization",
    "header_prefix": "Bearer"
  },
  "export": {
    "APOLLO_API_KEY": "API_TOKEN"
  }
}

