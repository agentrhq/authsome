// Resend
// Email sending, domains, audiences, and Resend API automation.
// auth: api_key | flow: api_key
// API keys are workspace-level; generate at resend.com/api-keys.
{
  "schema_version": 1,
  "name": "resend",
  "display_name": "Resend",
  "logo": "img.logo.dev/name/resend",
  "description": "Email sending, domains, audiences, and Resend API automation.",
  "type": "app",
  "auth_type": "api_key",
  "flow": "api_key",
  "api_url": "api.resend.com",
  "api_key": {
    "header_name": "Authorization",
    "header_prefix": "Bearer"
  },
  "export": {
    "RESEND_API_KEY": "API_TOKEN"
  }
}

