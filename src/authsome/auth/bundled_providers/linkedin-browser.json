{
  "schema_version": 1,
  "name": "linkedin-browser",
  "display_name": "LinkedIn \u2014 Browser Session",
  "logo": "img.logo.dev/name/linkedin",
  "description": "LinkedIn browser-session credentials for authenticated web workflows.",
  "type": "app",
  "auth_type": "browser",
  "flow": "browser",
  "api_url": "regex:^(www\\.linkedin\\.com|linkedin\\.com)",
  "browser": {
    "entry_url": "https://www.linkedin.com/login",
    "domains": [
      ".linkedin.com",
      "linkedin.com"
    ],
    "auth_cookies": [
      "li_at"
    ],
    "ttl_from_cookie": "li_at",
    "ttl_hours": 24,
    "extra_headers": {},
    "extract": [
      {
        "cookie": "JSESSIONID",
        "header": "csrf-token"
      }
    ]
  },
  "export": {
    "env": {
      "li_at": "LINKEDIN_LI_AT",
      "JSESSIONID": "LINKEDIN_JSESSIONID"
    }
  }
}
