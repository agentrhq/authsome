{
  "schema_version": 1,
  "name": "hubspot",
  "display_name": "HubSpot",
  "logo": "img.logo.dev/name/hubspot",
  "description": "CRM contacts, companies, deals, owners, and HubSpot workflow data.",
  "auth_type": "oauth2",
  "flow": "pkce",
  "api_url": "api.hubapi.com",
  "oauth": {
    "authorization_url": "https://app.hubspot.com/oauth/authorize",
    "token_url": "https://api.hubapi.com/oauth/v1/token",
    "revocation_url": "https://api.hubapi.com/oauth/v1/refresh-tokens/tokens",
    "device_authorization_url": null,
    "scopes": [
      "crm.objects.contacts.read",
      "crm.objects.contacts.write",
      "crm.objects.companies.read",
      "crm.objects.companies.write",
      "crm.objects.deals.read",
      "crm.objects.deals.write",
      "crm.objects.owners.read"
    ],
    "pkce": false,
    "supports_device_code": false,
    "supports_dcr": false
  },
  "export": {
    "HUBSPOT_ACCESS_TOKEN": "ACCESS_TOKEN"
  }
}
