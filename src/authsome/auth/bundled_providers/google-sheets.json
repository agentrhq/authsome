{
  "schema_version": 1,
  "name": "google-sheets",
  "display_name": "Google Sheets",
  "logo": "img.logo.dev/name/google-sheets",
  "description": "Google Sheets access for reading and editing spreadsheets via the Sheets API.",
  "auth_type": "oauth2",
  "flow": "pkce",
  "api_url": "https://sheets.googleapis.com/v4",
  "oauth": {
    "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_url": "https://oauth2.googleapis.com/token",
    "revocation_url": "https://oauth2.googleapis.com/revoke",
    "device_authorization_url": "https://oauth2.googleapis.com/device/code",
    "scopes": [
      "openid",
      "profile",
      "https://www.googleapis.com/auth/spreadsheets"
    ],
    "pkce": true,
    "supports_device_code": true,
    "supports_dcr": false
  },
  "export": {
    "GOOGLE_SHEETS_ACCESS_TOKEN": "ACCESS_TOKEN"
  }
}
