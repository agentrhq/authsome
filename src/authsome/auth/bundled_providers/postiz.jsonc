// Postiz
// Social publishing and Postiz API access through device authorization.
// auth: oauth2 | flow: device_code
// Postiz is self-hosted; device-code flow uses a custom JSON body format (not standard OAuth2 form).
{
  "schema_version": 1,
  "name": "postiz",
  "display_name": "Postiz",
  "logo": "img.logo.dev/name/postiz",
  "description": "Social publishing and Postiz API access through device authorization.",
  "type": "app",
  "auth_type": "oauth2",
  "flow": "device_code",
  "api_url": "api.postiz.com",
  "oauth": {
    "authorization_url": "https://platform.postiz.com/oauth/authorize",
    "token_url": "https://cli-auth.postiz.com/device/token",
    "revocation_url": null,
    "device_authorization_url": "https://cli-auth.postiz.com/device/code",
    "device_token_request": "json",
    "scopes": [],
    "pkce": true,
    "supports_device_code": true,
    "supports_dcr": false
  },
  "export": {
    "POSTIZ_ACCESS_TOKEN": "ACCESS_TOKEN"
  },
  "docs_url": "https://docs.postiz.com/public-api/oauth"
}

